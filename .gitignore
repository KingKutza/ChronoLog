# User data
*.ics
*.chronolog
*.journal
.chronolog-*
# The session the app writes beside itself -- layout, settings, view, and any
# theme a person authored. Generated, and it carries local paths.
chronolog.*
themes/

# Free space — anything under local/ never enters the repo
local/

# Build output
dist/
out/
*.tgz

# Launcher logs (written under the resolved data dir, which now defaults to the app root itself)
logs/

# Working machinery
.claude/

# OS / editor
.DS_Store
.vscode/
.idea/
.vs/
